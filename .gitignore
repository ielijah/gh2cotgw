# Additional exclusions retained from published repository
.runtime/
.vs/
rom/
build/
release/
__pycache__/
**/analysis/memory-*.bin
**/analysis/screen-*.png
# Local disc images and audio tracks
*.iso
*.cue
*.chd
*.img
*.mdf
*.mds
*.ccd
*.sub
*.wav
*.flac

*.state

# Published translated CD audio and launch cue only
/sega-cd/dub/*
!/sega-cd/dub/README.md
!/sega-cd/dub/tracks.json
!/sega-cd/dub/game.cue
!/sega-cd/dub/track0[2-9].wav
!/sega-cd/dub/track[2-7][0-9].wav
!/sega-cd/dub/track1[0-9].wav
!/sega-cd/dub/track90.wav
*.iso

!/sega-cd/dub/track8[0-9].wav

# Local manual renders, previews, and emulator memory dumps
/sega-cd/tmp/
/sega-cd/output/pdf/*
!/sega-cd/output/pdf/Genchou-Hishi-Mega-CD-Manual-RU.pdf
!/sega-cd/output/pdf/manual-full-layout-validation.json
/sega-cd/analysis/**/*.bin
/fix_manual_cover.py
/revise_war_manual.py
