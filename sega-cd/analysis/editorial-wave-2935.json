[
  {
    "file": "SMAIN.PRG;1",
    "offset": "280E4",
    "ja": "ﾓｳ少ｼｺﾞ成長ﾅｻｯﾃ\nｶﾗﾉ方ｶﾞﾖﾛｼｲｶﾄ…",
    "before": "Пусть\nсперва подрастёт",
    "after": "Пусть ещё\nнемного подрастёт."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2816C",
    "ja": "ﾀﾏﾆﾊ休養ﾓﾖｲﾓﾉ\nﾃﾞｽﾅ ﾜｯﾊｯﾊｯﾊ",
    "before": "Отдых\nтоже полезен",
    "after": "Отдых полезен.\nХа-ха-ха!"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "281DE",
    "ja": "ﾏﾂﾘｺﾞﾄﾊ私ﾒﾉ\n専門ﾆｺﾞｻﾞｲﾏｽ",
    "before": "Я сведущ\nв управлении",
    "after": "Я знаток\nуправления."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "28240",
    "ja": "私ﾓｺﾚﾃﾞ骨休ﾒｶﾞ\nﾃﾞｷﾙﾄｲｳﾓﾉﾃﾞｽ",
    "before": "Теперь можно\nотдыхать",
    "after": "Теперь и я\nсмогу отдохнуть."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "28386",
    "ja": "ｺﾉ日ｶﾞ来ﾙｺﾄｦ\n待ﾁ望ﾝﾃﾞｵﾘﾏｼﾀ",
    "before": "Я долго\nждал этого дня",
    "after": "Как я ждал\nэтого дня!"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "283A2",
    "ja": "私ﾓﾔｯﾄ一人前ﾆ\nﾅｯﾀ思ｲｶﾞｲﾀｼﾏｽ",
    "before": "Теперь и я\nстал взрослым",
    "after": "Теперь я\nсовсем взрослый."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2843A",
    "ja": "ｵ任ｾｸﾀﾞｻﾚ､決ｼﾃ\n不幸ﾅ思ｲﾊｻｾﾏｾﾇ",
    "before": "Верьте мне\nЯ её не обижу",
    "after": "Верьте мне.\nЯ её не обижу."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "286EA",
    "ja": "輸送ﾃﾞｷﾙ国ﾊ\nﾄﾞｺﾆﾓｺﾞｻﾞｲﾏｾﾝ",
    "before": "Некуда\nотправить груз",
    "after": "Некуда\nотправить груз."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2888C",
    "ja": "住民\u001bKﾓﾗﾙ\u001bHｶﾞ\nｻｶﾞｯﾃｼﾏｲﾏｼﾀｿﾞ",
    "before": "Дух народа\nупал",
    "after": "Народ стал\nменее доволен."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2895E",
    "ja": "ｺﾚ以上､ｺﾉ品物ｦ\n売ﾙｺﾄﾊﾃﾞｷﾏｾﾝ",
    "before": "Продать больше\nнельзя",
    "after": "Больше продать\nневозможно."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "289AA",
    "ja": "買ｳﾆﾊ金ｶﾞ少々\n足ﾘﾅｲﾖｳﾃﾞｽｶﾞ…",
    "before": "На покупку\nмало золота",
    "after": "Для покупки\nмало золота."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2924E",
    "ja": "ｺﾁﾗﾆﾓ相応ﾉ\n考ｴｶﾞｺﾞｻﾞｲﾏｽｿﾞ",
    "before": "Мы примем\nответные меры",
    "after": "Мы примем\nответные меры!"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2952C",
    "ja": "ｿﾉ国ﾄﾊ既ﾆ最長ﾉ\n同盟ｶﾞｻﾚﾃｲﾏｽ",
    "before": "Союз уже\nнельзя продлить",
    "after": "Срок союза\nуже предельный."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29598",
    "ja": "貢物ｦ要求ﾃﾞｷﾙ国ﾄ\n隣接ｼﾃｵﾘﾏｾﾇ",
    "before": "Дань требовать\nне у кого",
    "after": "Дань требовать\nне у кого."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2995E",
    "ja": "ｵ喜ﾋﾞｸﾀﾞｻｲ\n我ｶﾞ方ﾉ勝利ﾃﾞｽｿﾞ",
    "before": "Радуйтесь\nПобеда за нами",
    "after": "Радуйтесь!\nПобеда за нами!"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "299AC",
    "ja": "私ｯﾃ､ﾅﾝﾃ不幸ﾅ\n星ﾉ下ﾆ生ﾏﾚﾃｷﾀﾉ…",
    "before": "Моя\nзвезда несчастливая",
    "after": "Я родилась\nна свою беду..."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "27802",
    "ja": "ｺﾉﾜｼﾓﾄﾞｳﾔﾗ\n先ｶﾞ長ｸﾅｲﾖｳﾀﾞ",
    "before": "Мне недолго жить",
    "after": "Мне недолго жить."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2787C",
    "ja": "ｿﾚﾃﾞﾊ将軍ﾉ中ｶﾗ\nｵ選ﾋﾞｸﾀﾞｻｲ",
    "before": "Выберите\nиз генералов",
    "after": "Выберите\nиз генералов."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "27944",
    "ja": "ｵ体ﾉ具合ｲｶﾞ\nﾖﾛｼｸﾅｯﾀﾖｳﾃﾞｽﾅ",
    "before": "Вам стало\nлучше",
    "after": "Вам уже\nлучше, верно?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2795E",
    "ja": "ｵｶｹﾞ様ﾃﾞ\n体ﾉ調子ｶﾞﾖｸﾅﾘﾏｼﾀ",
    "before": "Спасибо\nМне стало лучше",
    "after": "Спасибо.\nМне стало лучше."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2704C",
    "ja": "ｲｯﾀｲﾄﾞﾅﾀｶﾞ跡目ｦ\nｵ継ｷﾞﾆﾅﾗﾚﾙﾉｶ…",
    "before": "Кто станет\nнаследником?",
    "after": "Кто же станет\nнаследником?.."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "27834",
    "ja": "年ﾉｾｲｶ､近頃ﾊ\n体ｶﾞ思ｳﾖｳﾆ動ｶﾇ",
    "before": "Старею\nТело не слушается",
    "after": "Старею.\nТело не слушается."
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "27ACE",
    "ja": "ﾓｯﾀｲﾌﾞﾗｽﾞﾆ\n早ｸ秘薬ｦ出ｼﾃｸﾚ",
    "before": "Дай лекарство\nскорее!",
    "after": "Скорей давай\nлекарство!"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4C5D8",
    "ja": "ｺﾞ覧ﾉ命令書ﾆ\n何ｶｺﾞ不満ﾊｱﾘﾏｽｶ",
    "before": "Чем плох этот приказ?",
    "after": "Вас не устраивает\nприказ?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4C77E",
    "ja": "部隊ﾉ移動ｦ\nﾄﾞﾚﾀﾞｹｵ望ﾐﾃﾞｽｶﾅ",
    "before": "Сколько войск\nпослать?",
    "after": "Сколько войск\nперевести?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4CCF2",
    "ja": "部隊ｦﾄﾞﾚﾀﾞｹ\n移動ｻｾﾙﾉﾃﾞｽｶﾅ",
    "before": "Сколько войск\nпослать?",
    "after": "Сколько войск\nперевести?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4CDEE",
    "ja": "ﾄﾞﾉ部隊ｦ\n解雇ﾅｻｲﾏｽｶ          ",
    "before": "Какие войска\nуволить?",
    "after": "Какие войска\nраспустить?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4D43E",
    "ja": "ｿﾚﾃﾞﾊﾄﾞﾉ将軍ﾆ\n指揮権ｦ委ﾈﾏｽｶ",
    "before": "Кому доверить\nвойско?",
    "after": "Какому генералу\nпоручить?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4B6B2",
    "ja": "ｲｯﾀｲﾄﾞﾅﾀｶﾞ跡目ｦ\nｵ継ｷﾞﾆﾅﾗﾚﾙﾉｶ",
    "before": "Кто станет\nнаследником?",
    "after": "Кто же станет\nнаследником?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4C558",
    "ja": "ﾄﾞﾉ国ﾉ命令書ｦ\n修正ﾅｻﾙﾉﾃﾞｽｶﾅ",
    "before": "Чей приказ исправим?",
    "after": "Чей приказ\nисправить?"
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "4C7F0",
    "ja": "脅迫ｻｾﾏｽｶｿﾚﾄﾓ\n貢物ｦ要求ｻｾﾏｽｶ",
    "before": "Угроза\nили дань?",
    "after": "Угроза\nили требование дани?"
  }
]
