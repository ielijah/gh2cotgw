      "native_prefix": "1b4232"
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27AE8",
      "ja": "ｿﾅﾀｶﾞ長春ｶ､ｲｯﾀｲﾄﾞﾝﾅ\n長生ﾉ秘薬ｦ知ｯﾃｲﾙﾉﾀﾞ?",
      "ru": "Чанчунь, ты знаешь\nсекрет долголетия?",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
      "max_lines": 2
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27BCA",
      "ja": "ｼﾂｺｸ尋ﾈﾙ\n潔ｸｱｷﾗﾒﾙ",
      "ru": "Настаять\nСдаться",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
      "max_lines": 2
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27BDC",
      "ja": "\n長春真人ｶﾞ到着ｼﾏｼﾀｿﾞ",
      "ru": "\nПрибыл Чанчунь!",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
      "max_lines": 2
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27BF2",
      "ja": "ｿﾉ必要ﾊ\nﾅｲ",
      "ru": "Не нужно",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
      "max_lines": 2
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27C02",
      "ja": "長春真人ｦｺﾉ地ﾆ招ｲﾃ\n秘薬ｦ求ﾒﾃﾊｲｶｶﾞﾃﾞｼｮｳｶ",
      "ru": "Позовём Чанчуня\nза зельем долголетия?",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
      "max_lines": 2
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27C2A",
      "ja": "不老長寿ﾉ\n法ﾆ通ｼﾞﾙ長春ﾅﾙ者ｶﾞｲﾙｿｳﾃﾞｽ",
      "ru": "Чанчунь знает\nсекрет долголетия",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
      "max_lines": 2
    },
    {
      "file": "SMAIN.PRG;1",
      "offset": "27C4E",
      "ja": "長春真人",
      "ru": "Чанчунь",
      "kind": "person_name",
      "max_columns": 22,
