    {
      "file": "INIT.PRG;1",
      "offset": "14FC2",
      "ja": "\u001bB2ﾄﾞﾉ種類ﾆｼﾏｽｶ?",
      "ru": "Категория?",
      "kind": "gameplay_dialogue",
      "max_columns": 22,
