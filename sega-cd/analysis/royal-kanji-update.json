    {
      "file": "INIT.PRG;1",
      "offset": "A37C",
      "ja": "\u001bKﾄﾚﾋﾞｿﾞﾝﾄ皇帝ｹﾞｵﾙｷﾞｵｽ1世\u001bH｡\n在位1266〜80｡",
      "ru": "Георгий I, император\nТрапезунда. 1266-80.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    },
    {
      "file": "INIT.PRG;1",
      "offset": "B70E",
      "ja": "\u001bKｳｲｸﾞﾙ\u001bHﾆ代官ﾄｼﾃ派遣ｻﾚﾀ西遼人｡\n\u001bKﾊﾞﾙﾁｭｸ\u001bHﾆ殺ｻﾚﾀ｡",
      "ru": "Западная Ляо.\nНаместник уйгуров.\nУбит Барчуком.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    },
    {
      "file": "INIT.PRG;1",
      "offset": "A3A8",
      "ja": "\u001bKﾙｰﾑ･ｾﾙｼﾞｭｰｸ\u001bH朝第6代･9代ﾉ\n\u001bKｽﾙﾀﾝ\u001bHｦ務ﾒﾀ｡\n在位1192〜96年､1204〜10年｡",
      "ru": "6-й и 9-й султан\nРумских сельджуков.\nПравил: 1192-1196,\n1204-1210.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    },
    {
      "file": "INIT.PRG;1",
      "offset": "11DCE",
      "ja": "\u001bKｲﾝﾄﾞ\u001bHﾉ\u001bKﾔｰﾀﾞｳﾞｧ\u001bH朝ﾉ第7代君主｡\n在位1271〜1310年｡",
      "ru": "7-й правитель Ядавов\nв Индии.\nПравил в 1271-1310.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    },
    {
      "file": "INIT.PRG;1",
      "offset": "11E84",
      "ja": "\u001bKﾘｭｰﾘｸ\u001bH家ﾉ\u001bKｳﾗｼﾞﾐﾙ\u001bH大公｡\n\u001bKﾉｳﾞｺﾞﾛﾄﾞ\u001bH公ﾓ兼ﾈﾀ｡\n在位1263〜72年｡",
      "ru": "Рюрикович.\nВеликий князь\nВладимира, князь\nНовгорода.\n1263-1272.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    },
    {
      "file": "INIT.PRG;1",
      "offset": "5A80",
      "ja": "\u001bKｱﾝﾄﾞﾛﾆｺｽ2世｡\nﾐｶｴﾙ8世\u001bHﾉ子｡\n父ﾉ没後､\u001bKﾋﾞｻﾞﾝﾂ\u001bH帝国皇帝位ﾆﾂｷ､\n父ﾄﾊ全ｸ異ﾅﾙ政策ｦﾄｯﾀ｡\n在位1282〜1328年｡",
      "ru": "Андроник II, сын\nМихаила VIII. Сменил\nотца на троне Византии\nи сменил его курс.\nПравил в 1282-1328.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    },
    {
      "file": "INIT.PRG;1",
      "offset": "647E",
      "ja": "\u001bKｱﾙ･ﾏﾘｸ･ｱﾙ･ｱﾌﾀﾞﾙ｡\nｻﾗﾃﾞｨﾝ\u001bHﾉ子｡\n\u001bKﾀﾞﾏｽｸｽ\u001bHﾃﾞ王位ﾆﾂｸｶﾞ､\nﾉﾁﾆ叔父ﾉ\u001bKｱﾙ･ｱｰﾃﾞｨﾙ\u001bHﾆ追放ｻﾚﾙ｡",
      "ru": "Аль-Малик аль-Афдаль,\nсын Салах ад-Дина.\nПравил Дамаском.\nДядя аль-Адиль\nизгнал.",
      "kind": "biography",
      "max_columns": 22,
      "max_lines": 5
    }
  ],
