[
  {
    "start": 14.58,
    "end": 26.78,
    "text": "条点より、見事ありて生まれたる青木王神ありき、そのつまなる、生じろきメジカーありき、"
  },
  {
    "start": 26.78,
    "end": 44.0,
    "text": "多いなる水海を、渡りてきぬ、十二世紀、逃走の歴史を繰り返す文語る余暴民族の中に、"
  },
  {
    "start": 44.0,
    "end": 53.46,
    "text": "一人の男子が誕生した 王者のあかしと言われる結果を"
  },
  {
    "start": 53.46,
    "end": 57.22,
    "text": "にぎって生まれたその子は 手無人となずけられ"
  },
  {
    "start": 57.22,
    "end": 66.47,
    "text": "多くの困難を乗り越え たくましく成長していった"
  },
  {
    "start": 66.47,
    "end": 71.79,
    "text": "その姿を青ぎ見た人々は 青きごう髪の伝説を思い出し"
  },
  {
    "start": 71.79,
    "end": 91.66,
    "text": "ぶわさしたという そのもの 目にひあり"
  },
  {
    "start": 91.66,
    "end": 93.66,
    "text": "おもてにひかりあり"
  }
]