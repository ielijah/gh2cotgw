[
  {
    "file": "SMAIN.PRG;1",
    "offset": "29CDA",
    "ja": "ﾔｻｼｲｵ方… \nﾜﾀｼﾉｺﾄｦ考ｴﾃｸﾀﾞｻｯﾀﾉﾈ",
    "ru": "Вы добры!\nПодумали обо мне.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29CFA",
    "ja": "后ﾖ今宵ﾊ\nﾓｳ眠ﾙﾄｼﾖｳ",
    "ru": "Милая, пора спать.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29D0E",
    "ja": "取ﾘ立ﾃﾃ申ｼ上ｹﾞﾙ\nｺﾄﾊｺﾞｻﾞｲﾏｾﾝﾜ",
    "ru": "Мне нечего\nрассказать.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29D2C",
    "ja": "印度ﾉ象ｦ\n一度近ｸﾃﾞ見ﾃﾐﾀｲﾓﾉﾃﾞｽ",
    "ru": "Хочу увидеть\nслонов Индии.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29D4A",
    "ja": "蒙古ﾉ騎兵ﾊ\nﾀｲｿｳ強ｲﾄ評判ﾃﾞｽﾜ",
    "ru": "Конница монголов\nсильна.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29D66",
    "ja": "東ﾉ方ﾆ\n黄金ﾉ島ｶﾞｱﾙｿｳﾃﾞｽﾈ",
    "ru": "На востоке\nостров злата",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29D80",
    "ja": "后ﾖ､ﾅﾆｶ\n面白ｲ話ﾊﾅｲｶ",
    "ru": "Есть ли\nновости?",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29D94",
    "ja": "ｱﾅﾀ様ﾉｺﾞ配下ﾊ\n誰ﾓｶﾞ立派ﾅ方ﾆｺﾞｻﾞｲﾏｽ",
    "ru": "Все ваши слуги\nдостойны уважения.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29DE0",
    "ja": "后ﾖ､ﾜｼﾉ\n部下ﾀﾁｦﾄﾞｳ思ｳｶ",
    "ru": "Как тебе\nмои слуги?",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29E40",
    "ja": "ｱｱﾝ､嬉ｼｲﾜｧｱﾅﾀ様ｦ\n見ﾙ目ｶﾞ変ﾜｯﾃｼﾏｲﾏｽ",
    "ru": "Я теперь смотрю\nна вас иначе!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29E64",
    "ja": "国庫ﾆﾅｲﾃﾞｽｯﾃ!ｲﾂﾓｲﾂﾓ\nｿｳｼﾃ私ｦﾀﾞﾏｼﾃﾊﾞｯｶﾘ…",
    "ru": "В казне пусто?\nОпять вы меня дурите!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29E8C",
    "ja": "ｲﾂﾓｿｳ… \nｱﾅﾀｯﾃ口先ﾊﾞｶﾘﾉ人ﾈ",
    "ru": "От вас\nодни слова.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29EC4",
    "ja": "何ﾓｲﾘﾏｾﾝ… ｱﾅﾀ様ｶﾗ\n頂ｸ物ﾊ全ﾃ血ﾉ臭ｲｶﾞｼﾏｽ",
    "ru": "Ничего не надо.\nДары пахнут кровью.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29EEC",
    "ja": "私ﾉｺﾄｦ本当ﾆ想ｯﾃｸﾀﾞｻﾙﾅﾗ\n他ﾆﾊ何ﾓｲﾘﾏｾﾝ…",
    "ru": "Любите меня,\nмне больше не надо.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29F12",
    "ja": "后ﾖ… ｿﾅﾀﾆ欲ｼｲﾓﾉｶﾞ\nｱﾙﾅﾗ何ﾅﾘﾄ申ｽｶﾞﾖｲ",
    "ru": "Милая,\nпроси чего угодно.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29F36",
    "ja": "ｲﾂﾓ子供ﾐﾀｲﾆﾀﾞﾀﾞﾊﾞｶﾘ\nｺﾈﾃ… 困ｯﾀｵ･ｶ･ﾀ",
    "ru": "Вы капризны,\nсловно ребёнок.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29F5A",
    "ja": "何ﾓｶﾓｶﾞ力ｽﾞｸﾃﾞ手ﾆ入ﾙﾄ\n思ｯﾀﾗ大間違ｲﾃﾞｽﾜﾖ",
    "ru": "Силой всего\nне добьёшься.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29F82",
    "ja": "欲ｼｲ物ﾊ何ﾄｼﾃﾓ手ﾆ入ﾚﾙ\nﾄｲｳﾉｶﾞｺﾉﾜｼﾉ信条ﾃﾞﾅ",
    "ru": "Я добуду всё,\nчего пожелаю.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29FAA",
    "ja": "天ﾖﾘﾓ高ｸ海ﾖﾘﾓ深ｸ\n想ｯﾃｵﾘﾏｽ",
    "ru": "Выше неба,\nглубже моря.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29FC4",
    "ja": "山ﾓ崩ﾚﾙｺﾄｶﾞｱﾘﾏｼｮｳ… \n湖ﾓ渇ﾚﾙｺﾄｶﾞｱﾘﾏｼｮｳ…",
    "ru": "И горы рушатся,\nи озёра пересыхают.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "29FEE",
    "ja": "ﾄﾞﾝﾅ山ﾖﾘﾓ高ｸ\nﾄﾞﾝﾅ湖ﾖﾘﾓ深ｸｿﾅﾀｦ愛ｼﾃｵﾙ",
    "ru": "Любовь выше гор\nи глубже озёр.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A012",
    "ja": "ｿﾉｵ言葉ｶﾞ､ﾀﾄｴ偽ﾘﾃﾞ\nｱﾘﾏｼｮｳﾄﾓ嬉ｼｭｳｺﾞｻﾞｲﾏｽﾜ",
    "ru": "Пусть это ложь,\nмне всё равно приятно.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A03C",
    "ja": "嘘ﾊﾞｶﾘ… ｱﾅﾀﾉ頭ﾊ他ﾉ女ﾔ\n戦ﾉｺﾄﾃﾞ一杯ﾃﾞｼｮｳﾆ",
    "ru": "Врёте! На уме лишь\nженщины и война.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A066",
    "ja": "ｿﾅﾀﾄ初ﾒﾃ出会ｯﾃｺﾉｶﾀ､\nｿﾅﾀｦ忘ﾚﾀｺﾄﾊ一時ﾓﾅｲ",
    "ru": "С первой встречи\nне забывал о тебе.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A08E",
    "ja": "何ﾓｵｯｼｬﾗﾅｲﾃﾞ… \nｱﾅﾀﾉｵ気持ﾁﾊﾜｶｯﾃｲﾏｽﾜ…",
    "ru": "Молчите, я знаю,\nчто вы чувствуете.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A0B4",
    "ja": "ﾓﾉ欲ｼｿｳﾅ目ｦﾅｻｯﾃﾓ\n何ﾓ出ﾃｷﾏｾﾝﾜﾖ",
    "ru": "Что за взгляд?\nНичего не дам.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A0D4",
    "ja": "ｲｲｴ… 私ﾆﾄｯﾃｱﾅﾀ様ﾊ\n決ｼﾃﾀﾀﾞﾉ男ｼﾞｬｱﾘﾏｾﾝﾉﾖ",
    "ru": "Вы больше для меня,\nчем лишь мужчина.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A0FC",
    "ja": "ｱｱﾖｶｯﾀ… ｿﾚｶﾞﾜｶﾗﾅｹﾚﾊﾞ\nﾀﾀﾞﾉ最低男ﾃﾞｽﾜﾖ",
    "ru": "Хорошо, вы поняли!\nИначе вы негодяй.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A122",
    "ja": "ｿﾝﾅ愚痴ﾊﾞｶﾘｵｯｼｬﾗﾚﾙ方ﾊ\n私､嫌ｲﾃﾞｽﾜ!",
    "ru": "Не люблю тех,\nкто вечно ноет!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A144",
    "ja": "ｿﾅﾀﾉ前ﾃﾞﾊﾜｼﾄﾃ､力ｦ持ﾀﾇ\nﾀﾀﾞﾉ男ﾆ過ｷﾞﾝﾉﾀﾞ",
    "ru": "Перед тобой\nя всего лишь мужчина.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A16A",
    "ja": "ｿﾉｵ気持ﾁﾀﾞｹﾃﾞﾓ私ﾆﾊ\nｼﾞｭｳﾌﾞﾝﾃﾞｺﾞｻﾞｲﾏｽ",
    "ru": "Мне достаточно\nвашей заботы.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A18E",
    "ja": "ｳｿﾊﾞｯｶﾘ､ｿﾝﾅｺﾄｶﾞ\nﾃﾞｷﾙﾊｽﾞｶﾞｱﾘﾏｾﾝﾜ",
    "ru": "Ложь! Вам это\nне по силам.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A1AE",
    "ja": "ｱﾅﾀｦ呼ﾌﾞｺﾄﾅﾝﾃ\nｷｯﾄｱﾘﾏｾﾝﾜ",
    "ru": "Я вас\nне позову.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A1C6",
    "ja": "ｿﾅﾀｶﾞ呼ﾍﾞﾊﾞ､千里ﾉｶﾅﾀｶﾗﾃﾞﾓ\n一夜ﾆｼﾃ駆ｹﾂｹﾙﾃﾞｱﾛｳ",
    "ru": "Позови, и я примчусь\nхоть с края света.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A1F4",
    "ja": "私ﾊ､ｱﾅﾀ様ｦ最ﾓ\nﾖｸ知ﾙ者ﾆﾅﾘﾀｲﾃﾞｽﾜ",
    "ru": "Хочу знать вас\nлучше всех.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A214",
    "ja": "ｱﾅﾀ様ﾉ浮ﾜﾂｲﾀｺﾞ所業ｦ\n知ﾗﾇ者ﾓ一人ﾓｵﾘﾏｾﾝﾜ…",
    "ru": "Все знают,\nкак вы ветрены.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A23E",
    "ja": "ｺﾞ自慢ﾊﾞｶﾘﾅｻﾙ癖ﾓｻｿﾞﾔ\n有名ﾆﾅｯﾃｲﾙｺﾄﾃﾞｼｮｳﾈ…",
    "ru": "Ваше хвастовство\nуже всем известно.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A268",
    "ja": "今ﾔ､ｺﾉ国ﾉ民ﾃﾞﾜｼﾉ名ｦ\n知ﾗﾇ者ﾊ一人ﾄｼﾃｵﾙﾏｲ",
    "ru": "В моей стране\nвсе знают моё имя.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A290",
    "ja": "政務ｦ執ﾗﾚﾙｱﾅﾀ様ﾉｵ姿ﾊ\n一段ﾄ素敵ﾃﾞｽﾜﾖ",
    "ru": "Вы так хороши\nза делами державы!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A2B4",
    "ja": "民ﾉ怨ﾐﾉ声ﾊｱﾅﾀ様ﾉ耳ﾏﾃﾞ\n届ｲﾃｵﾘﾏｾﾝﾉﾈ…",
    "ru": "Вы не слышите,\nкак ропщет народ.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A2D8",
    "ja": "女ﾆ政治ﾊﾜｶﾗﾇﾄｵｯｼｬﾙ割ﾆﾊ\nﾖｸ政治ﾉ話ｦﾅｻﾙﾉﾈ",
    "ru": "Политика не для нас?\nА вы всё о ней!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A300",
    "ja": "ﾜｼﾉ手腕ｦﾓｯﾃｽﾚﾊﾞ\n民ﾉ暮ｼﾓ安ﾝｼﾞﾗﾚﾖｳ",
    "ru": "Со мной народ\nзаживёт лучше.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A322",
    "ja": "ｱﾅﾀ様ｶﾞｺﾞ一緒ﾅﾗﾄﾞﾝﾅ\n危険ﾅﾄｺﾛﾆﾓ私ﾊ参ﾘﾏｽ",
    "ru": "С вами я пойду\nнавстречу опасности.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A34A",
    "ja": "女ﾉ手綱ｦ取ﾙﾆﾓ手間ﾄﾞﾙ\nｵ方ｶﾞ何ｦ申ｻﾚﾏｽ…",
    "ru": "Вам и с женщиной\nне совладать.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A370",
    "ja": "戦場ﾃﾞｼｶ良ｲ処ｦ見ｾﾗﾚﾅｲ\n男ｯﾃﾄﾃﾓ不幸ﾃﾞｽﾜ…",
    "ru": "Как жаль, что вы\nхороши только в бою.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A398",
    "ja": "ﾜｼﾉ戦場ﾃﾞﾉ指揮ﾌﾞﾘ\nｿﾅﾀﾆﾓ間近ﾃﾞ見ｾﾃﾔﾘﾀｲﾓﾉﾀﾞ",
    "ru": "Хочу, чтоб ты видела,\nкак я веду войско.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A3C2",
    "ja": "ｱﾅﾀ様ﾉｺﾞ武勇… \nｲﾂ聞ｲﾃﾓ惚ﾚ惚ﾚｼﾃｼﾏｲﾏｽﾜ〜",
    "ru": "Я всегда восхищаюсь\nвашей доблестью.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A3EA",
    "ja": "ｺｯｸﾘ… ｺｯｸﾘ… ｱﾗ失礼!\n話ﾉ途中ｶﾗ眠ｯﾃｼﾏｲﾏｼﾀﾜ",
    "ru": "Ох, простите!\nЯ уснула, слушая вас.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A416",
    "ja": "男ﾉ方ｯﾃ､ﾄﾞｳｼﾃ野蛮ﾅ話ｶﾞ\n好ｷﾅﾉ… 私ﾊﾓ〜ｳﾝｻﾞﾘ!",
    "ru": "Опять о жестокостях?\nМне уже надоело!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A442",
    "ja": "ﾜｼﾊ少ｼﾓ騒ｶﾞｽﾞ敵ｦ\nﾁｷﾞｯﾃﾊ投ｹﾞﾁｷﾞｯﾃﾊ投ｹﾞ…",
    "ru": "Я спокойно\nразметал врагов.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A46A",
    "ja": "ｿﾝﾅﾆ何度ﾓｵ呼ﾋﾞﾆﾅﾗﾅｸﾃﾓ\n逃ｹﾞﾀﾘﾊｼﾏｾﾝﾜ",
    "ru": "Не зовите так часто.\nЯ не сбегу.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A48E",
    "ja": "ｿｳｼﾃ繰ﾘ返ｻﾅｲﾄ女ﾉ名前\n一ﾂﾓ覚ｴﾗﾚﾅｲﾉﾃﾞｽﾈ…",
    "ru": "Без повторов и имя\nмоё не запомните?",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A4B6",
    "ja": "ｱｧ〜ﾏﾙﾃﾞ\u001bKｵｳﾑ!ｵｳﾑ\u001bHﾆﾊ\n\u001bKｵｳﾑ\u001bHｶﾞｵ似合ｲﾃﾞｽﾜﾖ!",
    "ru": "Ну прямо попугай!\nВам бы попугая в пару.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A502",
    "ja": "ﾄﾝﾃﾞﾓｺﾞｻﾞｲﾏｾﾝｱﾅﾀ様ｦ\nﾓｯﾄ知ﾘﾄｳｺﾞｻﾞｲﾏｽ",
    "ru": "Что вы!\nХочу узнать вас лучше.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A526",
    "ja": "ｱﾅﾀ様ﾉ浮ﾜﾂｲﾀｵ気持ﾁﾀﾞｹﾊ\n到底理解ﾃﾞｷﾏｾﾝ…",
    "ru": "Никак не пойму,\nоткуда эта ветреность.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A54E",
    "ja": "同ｼﾞｵ言葉ｦ先ﾎﾄﾞﾓ\nｵｯｼｬｯﾀｺﾄﾅﾗ存ｼﾞﾃｵﾘﾏｽｶﾞ…",
    "ru": "Помню,\nвы уже это говорили.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A578",
    "ja": "ｿﾅﾀﾊ賢ｲ… ｿﾅﾀﾉ知ﾗﾇｺﾄﾊ\n何ﾓﾅｲｶﾉﾖｳﾀﾞ…",
    "ru": "Ты так умна!\nТы словно знаешь всё.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A59C",
    "ja": "ﾏｱ… 気ﾊﾞｶﾘ強ｲ身内ﾊﾞｶﾘ\nﾆﾅｯﾃﾓ私ﾊ知ﾘﾏｾﾝﾜﾖ",
    "ru": "За строптивую родню\nя не отвечаю.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A5C4",
    "ja": "ｿﾉ気丈夫ﾅ子ｶﾞｱﾅﾀﾉ\nｵ手ｦ噛ﾑﾔﾓｼﾚﾏｾﾝﾈ",
    "ru": "Эта кроха ещё\nукусит вашу руку.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A5E6",
    "ja": "気弱ﾅｺﾄﾊﾞｶﾘｵｯｼｬﾙｵ方ﾆﾊ\n叶ﾜﾇ事ｶﾄ思ｲﾏｽ",
    "ru": "Вы так робки.\nВам это не по силам.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A60A",
    "ja": "ｿﾅﾀﾉ気丈夫ｻｦ受ｹ継ｲﾀﾞ\n子供ｶﾞ是非欲ｼｲﾓﾉﾀﾞﾅ…",
    "ru": "Хочу, чтоб наше дитя\nбыло смелым, как ты.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A636",
    "ja": "ﾏｱ… 今宵ﾉ託宣ﾊﾓｳ\n申ｼ上ｹﾞｽﾞﾄﾓｵﾜｶﾘﾃﾞｽﾜﾖﾈ",
    "ru": "Вы и сами знаете,\nчто сулит эта ночь.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A65E",
    "ja": "ｱﾅﾀ様ﾉｺﾞ叡知ﾃﾞﾊﾏｼﾅ\n口説ｷ文句ﾊｵ出ﾆﾅﾘﾏｾﾝﾉﾈ",
    "ru": "Неужели нет у вас\nкомплимента получше?",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A688",
    "ja": "何度ﾓ託宣ｦ求ﾒﾃﾊ\nｿﾉ効ｷ目ﾓﾅｸﾅﾙﾄ申ｼﾏｽ…",
    "ru": "Частые гадания\nтеряют силу.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A6AE",
    "ja": "ｿﾅﾀﾉ叡知ﾉ言葉ﾜｼﾆﾄｯﾃﾊ\n神ﾉ託宣ﾆ値ｽﾙﾉﾀﾞ",
    "ru": "Твои слова подобны\nвелению богов.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A6D4",
    "ja": "私ｶﾞ空ﾉ星ﾃﾞｱｯﾀﾗ毎夜毎夜\nｱﾅﾀ様ﾆｵ逢ｲﾃﾞｷﾏｽﾉﾆ",
    "ru": "Будь я звездой, мы бы\nвиделись по ночам.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A6FE",
    "ja": "朝ﾆﾊ星ｶﾞ隠ﾚﾙ様ﾆ\n朝ﾆﾊ私ﾉｺﾄｦｵ忘ﾚﾆﾅﾙﾃﾞｼｮｳ",
    "ru": "Утром звёзд нет.\nВы забудете и меня.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A726",
    "ja": "今宵ﾉ空ﾉ星ﾉ数ﾀﾞｹｿﾉﾖｳﾅ\n繰ﾘ言ｦｵｯｼｬｲﾏｽﾉ…",
    "ru": "У вас столько лести,\nсколько звёзд?",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A74E",
    "ja": "ｿﾅﾀﾉ美ｼｻﾊﾏﾙﾃﾞ\n今宵ﾉ空ﾉ星ﾉﾖｳﾀﾞ",
    "ru": "Ты красива,\nкак звезда.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A780",
    "ja": "今宵ﾊｿﾅﾀﾉ病ｦ案ｼﾞﾃ\n来ﾀﾉﾀﾞ 安ﾝｽﾞﾙｶﾞﾖｲｿﾞ…",
    "ru": "Я пришёл узнать,\nкак твоё здоровье.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A7A8",
    "ja": "ｳﾑｳﾑ､ｿｳｾｶｻｽﾞﾄﾓﾖｲ\nﾏﾀﾞﾏﾀﾞ夜ﾊ長ｲｿﾞ",
    "ru": "Не торопись.\nНочь ещё долгая.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A7C8",
    "ja": "ｿﾅﾀﾉ顔ｶﾞ見ﾀｸﾅｯﾃﾅ… \nｼﾊﾞﾗｸﾌﾞﾘﾀﾞﾅ",
    "ru": "Давно не виделись!\nЯ скучал.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A7E8",
    "ja": "后ﾖ､ｲﾂﾏﾃﾞ泣ｲﾃｲﾃﾓ仕方\nｱﾙﾏｲ… 機嫌ｦ直ｼﾃｸﾚﾇｶ",
    "ru": "Слезами не поможешь.\nНу же, улыбнись!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A812",
    "ja": "ﾂﾚﾅｲｺﾄﾊﾞｶﾘ言ｳﾃﾞﾅｲｿﾞ…\n今日ﾊ后ｦ慰ﾒﾆ参ｯﾀﾉﾀﾞ",
    "ru": "Не будь холодна.\nЯ пришёл утешить тебя.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A83C",
    "ja": "ｵ待ﾁ申ｼ上ｹﾞﾃｵﾘﾏｼﾀﾜ",
    "ru": "Я вас ждала.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A850",
    "ja": "流行ﾘﾉ病ﾆｶｶﾘ体ｶﾞﾏｯﾀｸ\n言ｳｺﾄｦ聞ｷﾏｾﾇ… ｺﾞﾎｺﾞﾎ",
    "ru": "Я тяжело заболела.\nСовсем нет сил.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A87C",
    "ja": "様… \nｵ待ﾁｼﾃｵﾘﾏｼﾀ早ｸｺﾁﾗﾆｲﾗｼﾃ",
    "ru": ",\nЯ вас ждала!",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A89A",
    "ja": "ｺﾚﾊｵ珍ｼｲ… 一体ﾄﾞｳｲｳ\n風ﾉ吹ｷ回ｼﾃﾞｼｮｳ",
    "ru": "Вот сюрприз!\nС чего это вдруг?",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A8BE",
    "ja": "ｼｸｼｸ…  私ﾉｺﾄｦｵ考ｴ\n下ｻﾙﾅﾗﾄﾞｳｶｵ引ｷ取ﾘｦ…",
    "ru": "Если я вам дорога,\nпрошу вас уйти.",
    "max_columns": 22,
    "max_lines": 2
  },
  {
    "file": "SMAIN.PRG;1",
    "offset": "2A8E6",
    "ja": "今宵ﾊ誰ﾄﾓ会ｲﾀｸｱﾘﾏｾﾝ\nｵ引ｷ取ﾘ願ｲﾏｽ",
    "ru": "Не хочу никого видеть.\nУходите.",
    "max_columns": 22,
    "max_lines": 2
  }
]
